# Kontaktformular (src/app/api/kontakt/route.ts)
# API-Key aus einem Resend-Konto (https://resend.com). Ohne diesen Wert
# schlägt der Versand serverseitig fehl und das Formular öffnet stattdessen
# das E-Mail-Programm der Besucherin/des Besuchers als Auffangnetz.
RESEND_API_KEY=

# Absenderadresse für die Anfrage-E-Mails. Erfordert eine in Resend
# verifizierte Domain (DNS-Einträge) — bis dahin funktioniert nur die
# Resend-Testadresse "Atelier AA Website <onboarding@resend.dev>" (Standard,
# wenn diese Variable leer bleibt), die Resend nur an die eigene
# Kontoadresse zustellt.
CONTACT_FROM_EMAIL="Atelier AA Website <kontakt@atelier-aa.ch>"

# Empfängeradresse für Anfragen. Standard ist firma.email (info@atelier-aa.ch),
# diese Variable muss nur gesetzt werden, um davon abzuweichen.
CONTACT_TO_EMAIL=

# Google Analytics (src/components/cookies/GoogleAnalytics.tsx) — lädt nur,
# wenn zusätzlich die Statistik-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta-Werbepixel (src/components/cookies/MarketingPixel.tsx) — lädt nur,
# wenn zusätzlich die Marketing-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Mailing-Bereich unter /mailer — nur intern, nicht verlinkt, noindex
# ---------------------------------------------------------------------------
# Brevo: ausschliesslich serverseitig. Niemals mit NEXT_PUBLIC_ praefixen.
BREVO_API_KEY=
# Versandadresse. news@atelier-aa.ch muss bei Hostpoint als echtes Postfach
# angelegt sein, nicht als Weiterleitung ins Leere: Ruecklaeufer, Abwesenheits-
# meldungen und Antworten von Leuten, die auf "Antworten" druecken statt an
# Reply-To zu denken, landen dort. Kein "noreply" verwenden, das wird von
# Spamfiltern und Empfaengern schlecht aufgenommen.
BREVO_SENDER_EMAIL=news@atelier-aa.ch
BREVO_SENDER_NAME=Alisami Aljili | Atelier AA Architekten
# Antworten sollen im Hauptpostfach landen, nicht bei news@.
BREVO_REPLY_TO=aljili@atelier-aa.ch

# Absender des Anmeldelinks fuer /mailer (laeuft ueber Resend, nicht Brevo).
MAILER_FROM_EMAIL=Atelier AA Architekten <news@atelier-aa.ch>
BREVO_MAILER_FOLDER_NAME=Atelier AA Mailings

# Die einzige Adresse, die sich am Mailer anmelden darf.
MAILER_ADMIN_EMAIL=aljili@atelier-aa.ch

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
MAILER_SESSION_SECRET=

# Basis fuer den Anmeldelink in der E-Mail.
MAILER_BASE_URL=https://www.atelier-aa.ch
