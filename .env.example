# Kontaktformular (src/app/api/kontakt/route.ts)
# API-Key aus einem Resend-Konto (https://resend.com). Ohne diesen Wert
# schlägt der Versand serverseitig fehl und das Formular öffnet stattdessen
# das E-Mail-Programm der Besucherin/des Besuchers als Auffangnetz.
RESEND_API_KEY=

# Absenderadresse für die Anfrage-E-Mails. Erfordert eine in Resend
# verifizierte Domain (DNS-Einträge) — bis dahin funktioniert nur die
# Resend-Testadresse "Atelier AA Website <onboarding@resend.dev>" (Standard,
# wenn diese Variable leer bleibt), die Resend nur an die eigene
# Kontoadresse zustellt.
CONTACT_FROM_EMAIL="Atelier AA Website <kontakt@atelier-aa.ch>"

# Empfängeradresse für Anfragen. Standard ist firma.email (info@atelier-aa.ch),
# diese Variable muss nur gesetzt werden, um davon abzuweichen.
CONTACT_TO_EMAIL=

# Google Analytics (src/components/cookies/GoogleAnalytics.tsx) — lädt nur,
# wenn zusätzlich die Statistik-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta-Werbepixel (src/components/cookies/MarketingPixel.tsx) — lädt nur,
# wenn zusätzlich die Marketing-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_META_PIXEL_ID=
