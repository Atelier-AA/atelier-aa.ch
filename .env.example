# --- Kontaktformular ------------------------------------------------------
#
# Es gibt zwei Wege, je nach Ort:
#
#   Hostpoint (Produktion)  kontakt.php, versendet mit PHP-mail().
#                           Braucht KEINE dieser Variablen. Der Empfänger
#                           steht fest in hostpoint/kontakt.php.
#   Vercel (Vorschau)       src/app/api/kontakt/route.ts, versendet über
#                           Resend. Ohne Schlüssel schlägt der Versand fehl
#                           und das Formular öffnet als Auffangnetz das
#                           E-Mail-Programm der Besucherin oder des Besuchers.

# Zugangsschlüssel für Resend. Nur für die Vercel-Fassung nötig.
RESEND_API_KEY=

# Absenderadresse. Resend stellt nur von einer verifizierten Domain zu; bis
# die DNS-Einträge gesetzt sind, funktioniert allein die Kontoadresse.
CONTACT_FROM_EMAIL="Atelier AA Website <kontakt@atelier-aa.ch>"

# Empfängeradresse für Anfragen. Ohne Angabe gilt firma.email
# (info@atelier-aa.ch); nur setzen, um davon abzuweichen.
CONTACT_TO_EMAIL=

# Google Analytics (src/components/cookies/GoogleAnalytics.tsx) — lädt nur,
# wenn zusätzlich die Statistik-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta-Werbepixel (src/components/cookies/MarketingPixel.tsx) — lädt nur,
# wenn zusätzlich die Marketing-Kategorie im Cookie-Banner zugestimmt wurde.
NEXT_PUBLIC_META_PIXEL_ID=
